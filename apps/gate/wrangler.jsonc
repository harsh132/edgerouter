{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgerouter-gate",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Verified live against https://api.testnet.blocky402.com/supported.
    //
    // Two networks, each settled by whichever facilitator actually settles it.
    //
    // Blocky402 does Hedera, and is the only facilitator that does. It also
    // advertises Polygon Amoy, but its Amoy leg does not work: /verify answers
    // `transaction_simulation_failed` for every payload, including ones that
    // simulate cleanly on a public RPC from Blocky402's own signer address, and
    // including deliberately broken quotes whose specific failures its own code
    // has distinct reasons for. A generic answer to every input is what a
    // facilitator whose chain reads are failing looks like. So Amoy is not
    // offered: a network we cannot settle on is worse than one we do not list,
    // because the client signs, waits, and is refused after doing the work.
    //
    // Base Sepolia settles through x402.org's facilitator instead, which is why
    // facilitatorUrl is per network rather than per gate. No facilitator covers
    // everything, and the ones that overlap do not overlap completely.
    //
    // Both EIP-712 domains are read from the contract rather than assumed:
    // name() returns "USDC" (not "USD Coin", which several other deployments
    // use) and version() returns "2". A wrong domain produces a signature that
    // verifies against nothing, and surfaces at the facilitator looking like a
    // malformed payment rather than a wrong domain.
    //
    // Hedera uses HBAR (0.0.0) rather than an HTS token, because HTS transfers
    // additionally require the payer's account to be *associated* with the
    // token — an extra step that has nothing to do with what is being tested.
    // Amounts on Hedera are tinybars, 10^8 per HBAR.
    //
    // feePayer is the facilitator's own sponsoring account, not ours to choose.
    //
    // unitsPerUsdMinor converts a USD price into the asset's own smallest unit.
    // USDC has six decimals, so on an EVM USDC network it is 1. HBAR has eight
    // decimals and a price: the network's own exchange rate (mirror node
    // /api/v1/network/exchangerate) put 1 HBAR at $0.081, so one USD minor unit
    // is ~1234 tinybars. It is a fixed number rather than an oracle read, which
    // means the quote drifts as the price moves — acceptable on testnet, not on
    // mainnet.
    "NETWORKS": "[{\"kind\":\"hedera\",\"id\":\"hedera:testnet\",\"asset\":\"0.0.0\",\"payTo\":\"0.0.10400448\",\"feePayer\":\"0.0.7162784\",\"unitsPerUsdMinor\":\"1234\"},{\"kind\":\"evm\",\"id\":\"eip155:84532\",\"asset\":\"0x036CbD53842c5426634e7929541eC2318f3dCF7e\",\"payTo\":\"0x3f870ECEEE0EcE3a54254C1D364230ABd14aa2d3\",\"assetName\":\"USDC\",\"assetVersion\":\"2\",\"unitsPerUsdMinor\":\"1\",\"facilitatorUrl\":\"https://x402.org/facilitator\"}]",
    "DEFAULT_NETWORK": "hedera:testnet",
    // Public, so it is a var rather than a secret. Which facilitator settles
    // our payments is not a thing to hide, and hiding it would mean nobody can
    // read the deployed config to check it matches what we quote.
    "FACILITATOR_URL": "https://api.testnet.blocky402.com"
  },
  // No storage bindings. The gate settles before it serves, so it never extends
  // credit and has no debt to remember — which is what lets it stay stateless
  // and permissionless at the same time.
  // Secrets, set with `wrangler secret put`, never in this file:
  //   OPENROUTER_API_KEY   required — the upstream this gate resells
  //   SERVICE_SECRET       only to verify capabilities; anonymous paid calls
  //                        work without it
  //   FACILITATOR_API_KEY  only if the facilitator requires one
}
