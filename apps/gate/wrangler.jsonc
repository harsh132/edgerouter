{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgerouter-gate",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Base Sepolia by default: a testnet, so a misconfigured deploy cannot
    // move real money. Override per environment.
    "PAYMENT_NETWORK": "eip155:84532",
    "PAYMENT_ASSET": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
    "PAYMENT_PAY_TO": "0x0000000000000000000000000000000000000000",
    "PAYMENT_ASSET_NAME": "USDC",
    "PAYMENT_ASSET_VERSION": "2"
  }
  // Secrets, set with `wrangler secret put`, never in this file:
  //   SERVICE_SECRET, FACILITATOR_URL, FACILITATOR_API_KEY, OPENROUTER_API_KEY
}
