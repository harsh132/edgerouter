{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgerouter-gate",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Verified live against https://api.testnet.blocky402.com/supported.
    //
    // Hedera only, for now. Blocky402 also settles Polygon Amoy (eip155:80002),
    // and an entry for it lived here until deployment — but its payTo was still
    // the zero address, so anyone who chose that network would have burned
    // their payment. A network we cannot receive on is worse than one we do not
    // offer: the client signs successfully, the facilitator settles
    // successfully, and the money is gone. Restore it with a real address.
    //
    // Hedera uses HBAR (0.0.0) rather than an HTS token, because HTS transfers
    // additionally require the payer's account to be *associated* with the
    // token — an extra step that has nothing to do with what is being tested.
    // Amounts on Hedera are tinybars, 10^8 per HBAR.
    //
    // feePayer is the facilitator's own sponsoring account, not ours to choose.
    //
    // unitsPerUsdMinor converts a USD price into the asset's own smallest unit.
    // USDC has six decimals, so on an EVM USDC network it is 1. HBAR has eight
    // decimals and a price: the network's own exchange rate (mirror node
    // /api/v1/network/exchangerate) put 1 HBAR at $0.081, so one USD minor unit
    // is ~1234 tinybars. It is a fixed number rather than an oracle read, which
    // means the quote drifts as the price moves — acceptable on testnet, not on
    // mainnet.
    "NETWORKS": "[{\"kind\":\"hedera\",\"id\":\"hedera:testnet\",\"asset\":\"0.0.0\",\"payTo\":\"0.0.10400448\",\"feePayer\":\"0.0.7162784\",\"unitsPerUsdMinor\":\"1234\"}]",
    "DEFAULT_NETWORK": "hedera:testnet",
    // Public, so it is a var rather than a secret. Which facilitator settles
    // our payments is not a thing to hide, and hiding it would mean nobody can
    // read the deployed config to check it matches what we quote.
    "FACILITATOR_URL": "https://api.testnet.blocky402.com"
  },
  // No storage bindings. The gate settles before it serves, so it never extends
  // credit and has no debt to remember — which is what lets it stay stateless
  // and permissionless at the same time.
  // Secrets, set with `wrangler secret put`, never in this file:
  //   OPENROUTER_API_KEY   required — the upstream this gate resells
  //   SERVICE_SECRET       only to verify capabilities; anonymous paid calls
  //                        work without it
  //   FACILITATOR_API_KEY  only if the facilitator requires one
}
