{
  "name": "edgerouter",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun packages/core/check.ts && bun apps/gate/check.ts",
    "smoke": "bun apps/gate/smoke.ts",
    "dev": "wrangler dev --config apps/gate/wrangler.jsonc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.129.0"
  }
}
