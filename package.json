{
  "name": "edgerouter",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun packages/core/check.ts && bun packages/sdk/check.ts && bun packages/sdk/wallet-check.ts && bun packages/sdk/evm-check.ts && bun packages/sdk/delegate-check.ts && bun packages/dsh/check.ts && bun packages/dsh/delegation-check.ts && bun apps/gate/check.ts && bun apps/gate/config-check.ts",
    "smoke": "bun apps/gate/smoke.ts",
    "dev": "wrangler dev --config apps/gate/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "facilitator-check": "bun apps/gate/facilitator-check.ts",
    "pay-check": "bun packages/sdk/pay-check.ts",
    "live-check": "bun packages/dsh/live-check.ts",
    "ens-check": "bun packages/ens/live-check.ts",
    "ens-guard-check": "bun packages/ens/guard-live-check.ts",
    "ens-revoke-check": "bun packages/ens/revoke-live-check.ts",
    "authority": "bun packages/sdk/authority-serve.ts",
    "wallet": "bun packages/sdk/wallet.ts",
    "fund-check": "bun packages/sdk/fund-check.ts",
    "delegate-live-check": "bun packages/sdk/delegate-live-check.ts",
    "send": "bun packages/sdk/send.ts",
    "evm-pay-check": "bun packages/sdk/evm-pay-check.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.129.0"
  }
}
